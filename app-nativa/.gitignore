# Copias del sitio web que Capacitor genera al sincronizar — la app carga el sitio en vivo (server.url),
# no estas copias locales, así que no hace falta versionarlas (se regeneran con `npx cap sync`).
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate

# Secrets / signing (nunca deben subirse)
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
*.p8
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# OS
.DS_Store
Thumbs.db
