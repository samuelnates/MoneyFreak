# Copia este archivo a "keystore.properties" (mismo folder) y rellena los
# valores reales -- ese archivo SÍ está en .gitignore, nunca se sube.
# La llave real (money-freak-release.keystore) se entregó aparte, fuera del
# repo -- guárdala en un lugar seguro (gestor de contraseñas o similar);
# si se pierde y la cuenta no está inscrita en Play App Signing, la app no
# se puede volver a actualizar bajo la misma ficha de Play Store.
storeFile=../money-freak-release.keystore
storePassword=
keyAlias=moneyfreak
keyPassword=
